# AI provider. Leave as "local" for deterministic offline drafts, or set to
# "bedrock" to use Amazon Bedrock. AWS credentials are read by the AWS SDK
# from your local AWS profile/environment or from the deployed Lambda IAM role.
AI_PROVIDER=local
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AI_MAX_OUTPUT_TOKENS=220

# Optional server-side fallback for local development. Never expose this key in
# frontend code or commit it. Gemini is used only if Bedrock is not available.
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=512

# Python AI Chatbot URL (automatically set in production by Amplify)
# For local development, set to http://localhost:8000
PYTHON_AI_URL=http://localhost:8000
CHATBOT_URL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local API server. The frontend uses port 3000; the API defaults to 3001.
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# AWS Configuration (eu-west-2 London)
AWS_REGION=eu-west-2
TABLE_NAME=ClassLineTable
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Optional: point the API at DynamoDB Local when developing without AWS.
# DYNAMODB_ENDPOINT=http://localhost:8000
